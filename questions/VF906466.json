    "itemXml": "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\"?><assessmentItem xmlns=\"http://www.imsglobal.org/xsd/imsqti_v2p1\" xmlns:xi=\"http://www.w3.org/2001/XInclude\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" adaptive=\"false\" identifier=\"VF906466\" timeDependent=\"false\" title=\"VF906466\" xsi:schemaLocation=\"http://www.imsglobal.org/xsd/imsqti_v2p1 http://www.imsglobal.org/xsd/qti/qtiv2p1/imsqti_v2p1.xsd\"><responseDeclaration baseType=\"identifier\" cardinality=\"single\" identifier=\"RESPONSE_A\"><correctResponse><value>rAi2</value></correctResponse></responseDeclaration><responseDeclaration baseType=\"identifier\" cardinality=\"multiple\" identifier=\"RESPONSE_B\"><correctResponse><value>rBi1</value><value>rBi3</value><value>rBi6</value></correctResponse></responseDeclaration><outcomeDeclaration baseType=\"float\" cardinality=\"single\" identifier=\"SCORE\" normalMaximum=\"2.0\" normalMinimum=\"0.0\"/><outcomeDeclaration baseType=\"float\" cardinality=\"single\" identifier=\"SCORE_A\" normalMaximum=\"1.0\" normalMinimum=\"0.0\"/><outcomeDeclaration baseType=\"float\" cardinality=\"single\" identifier=\"SCORE_B\" normalMaximum=\"1.0\" normalMinimum=\"0.0\"/><templateDeclaration baseType=\"float\" cardinality=\"single\" identifier=\"SCORE_A_MAX\"><defaultValue><value>1</value></defaultValue></templateDeclaration><templateDeclaration baseType=\"float\" cardinality=\"single\" identifier=\"SCORE_B_MAX\"><defaultValue><value>1</value></defaultValue></templateDeclaration><itemBody><div class=\"row\">\n\t<div class=\"span6\"><div class=\"passageContent\" xml:base=\"VF581001_s.xml\"><div class=\"abbi-richtext\"><p class=\"passage-intro\" id=\"sr122\">Today you will research fossils. You will read the article “Miss Me?” Then you will read an article “Clues to Ancient Life” and view the video <i>Croc Fossil Found in Cave</i>. As you review these sources, you will gather information and answer questions about fossils so you can write an essay.</p></div></div>\n    \t<div class=\"stimulus\">\n\t\t\t<div class=\"passage-scrolling passage440\">\n\t\t\t\t<div class=\"passageContent\" xml:base=\"VF496993.xml\"><div class=\"abbi-richtext\"><div class=\"stimulus_reference\"> <div class=\"passage\"> <div class=\"prose style:1\"> <p class=\"directions-passage\" id=\"sr\">Watch the video <em>Croc Fossil Found in Cave.</em> Then answer the questions.</p> </div> </div> </div></div><div class=\"abbi-video\"><object data=\"assets/VF496993.v01.mp4\" type=\"video/mp4\"><param name=\"webmSource\" value=\"assets/VF496993.v01.webm\" valuetype=\"REF\"/></object></div><div class=\"abbi-richtext\"><p class=\"copyright-tm\">Ngdm/National Geographic Stock</p></div></div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class=\"span6\"><div class=\"abbi-richtext\"><h4>Part A</h4></div><div class=\"abbi-richtext\"><p class=\"stem_paragraph\" id=\"c1\">What is the central idea of the video <i>Croc Fossil Found in Cave</i>?</p></div><choiceInteraction class=\"choice_list\" maxChoices=\"1\" minChoices=\"1\" orientation=\"vertical\" responseIdentifier=\"RESPONSE_A\" shuffle=\"false\"><simpleChoice identifier=\"rAi1\"><p class=\"choice_paragraph\" id=\"c2\">Scientists need to start looking for unexplored areas to make new discoveries.</p></simpleChoice><simpleChoice identifier=\"rAi2\"><p class=\"choice_paragraph\" id=\"c3\">Amazing discoveries have been made in caves in the Dominican Republic.</p></simpleChoice><simpleChoice identifier=\"rAi3\"><p class=\"choice_paragraph\" id=\"c4\">Freshwater caves are a wonderful place to find unknown species.</p></simpleChoice><simpleChoice identifier=\"rAi4\"><p class=\"choice_paragraph\" id=\"c5\">Funding for new explorations needs to be a focus for scientists.</p></simpleChoice></choiceInteraction><div class=\"abbi-richtext\"><h4>Part B</h4></div><div class=\"abbi-richtext\"><p class=\"stem_paragraph\" id=\"c7\">Which <b class=\"stressed_text_1\">three </b>details from the video <b class=\"stressed_text_1\">best </b>support the answer to Part A?</p></div><choiceInteraction class=\"choice_list\" maxChoices=\"0\" minChoices=\"1\" orientation=\"vertical\" responseIdentifier=\"RESPONSE_B\" shuffle=\"false\"><simpleChoice identifier=\"rBi1\"><p class=\"choice_paragraph\" id=\"c8\">The crocodile was found where crocodiles have never been seen.</p></simpleChoice><simpleChoice identifier=\"rBi2\"><p class=\"choice_paragraph\" id=\"c9\">The end of a crocodile snout stuck out of the sand.</p></simpleChoice><simpleChoice identifier=\"rBi3\"><p class=\"choice_paragraph\" id=\"c10\">The fossils were in great shape because of the cold water.</p></simpleChoice><simpleChoice identifier=\"rBi4\"><p class=\"choice_paragraph\" id=\"c11\">There are other caves that are easier to get into.</p></simpleChoice><simpleChoice identifier=\"rBi5\"><p class=\"choice_paragraph\" id=\"c12\">It is hard to find good complete bones in the dirt.</p></simpleChoice><simpleChoice identifier=\"rBi6\"><p class=\"choice_paragraph\" id=\"c13\">Remains of many different types of animals were found.</p></simpleChoice><simpleChoice identifier=\"rBi7\"><p class=\"choice_paragraph\" id=\"c14\">The entrance to the cave was in a remote area.</p></simpleChoice></choiceInteraction></div>\n</div></itemBody><responseProcessing><responseCondition><responseIf><match><variable identifier=\"RESPONSE_A\"/><correct identifier=\"RESPONSE_A\"/></match><setOutcomeValue identifier=\"SCORE_A\"><baseValue baseType=\"float\">1</baseValue></setOutcomeValue></responseIf><responseElse><setOutcomeValue identifier=\"SCORE_A\"><baseValue baseType=\"float\">0</baseValue></setOutcomeValue></responseElse></responseCondition><responseCondition><responseIf><match><variable identifier=\"RESPONSE_B\"/><correct identifier=\"RESPONSE_B\"/></match><setOutcomeValue identifier=\"SCORE_B\"><baseValue baseType=\"float\">1</baseValue></setOutcomeValue></responseIf><responseElse><setOutcomeValue identifier=\"SCORE_B\"><baseValue baseType=\"float\">0</baseValue></setOutcomeValue></responseElse></responseCondition><responseCondition><responseIf><equal><variable identifier=\"SCORE_A\"/><variable identifier=\"SCORE_A_MAX\"/></equal><responseCondition><responseIf><equal><variable identifier=\"SCORE_B\"/><variable identifier=\"SCORE_B_MAX\"/></equal><setOutcomeValue identifier=\"SCORE\"><baseValue baseType=\"float\">2</baseValue></setOutcomeValue></responseIf><responseElse><setOutcomeValue identifier=\"SCORE\"><baseValue baseType=\"float\">1</baseValue></setOutcomeValue></responseElse></responseCondition></responseIf><responseElse><setOutcomeValue identifier=\"SCORE\"><baseValue baseType=\"float\">0</baseValue></setOutcomeValue></responseElse></responseCondition></responseProcessing></assessmentItem>"
